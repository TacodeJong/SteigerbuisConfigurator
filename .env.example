# Free private model limit (also enforced in DB RPC)
FREE_PRIVATE_MODEL_LIMIT=3

# Supabase (EU region) — public keys only; never put service role in the frontend
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Billing (Mollie) — API keys ONLY as Supabase Edge Function secrets (never in Vite / DB)
# Prefer mode-specific keys; admin toggles app_settings.mollie_mode (test|live)
MOLLIE_API_KEY_TEST=
MOLLIE_API_KEY_LIVE=
# Optional legacy fallback (only used if prefix matches selected mode):
# MOLLIE_API_KEY=
# Optional Edge secret override for charge amount (default 7.00 = €7 / maand)
# npx supabase secrets set MOLLIE_PAYMENT_AMOUNT=7.00
MOLLIE_PAYMENT_AMOUNT=7.00
MOLLIE_WEBHOOK_SECRET=
# Optional Stripe fallback
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Checkout return URL — Mollie rejects localhost / private IPs; use public HTTPS
VITE_BILLING_RETURN_URL=https://steigerbuisontwerpen.nl/?billing=return

# Maandabonnement weergavenaam (houd synchroon met MOLLIE_PAYMENT_AMOUNT)
VITE_PAID_PLAN_LABEL=Maandabonnement
VITE_PAID_PLAN_PRICE_HINT=€7 / maand · betaal bij checkout (iDEAL)
